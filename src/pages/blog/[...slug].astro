---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const allPosts = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} - Kevan Ahlquist`}
  description={post.data.description}
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogUrl={`https://www.kevanahlquist.com/blog/${post.id}/`}
  canonicalUrl={post.data.canonicalUrl}
  bodyClass="blog"
>
    <div class="blog-layout">
        <nav class="blog-toc">
            <h2>All Posts</h2>
            <ul>
                {allPosts.map(p => (
                    <li class={p.id === post.id ? 'active' : ''}>
                        <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                    </li>
                ))}
            </ul>
        </nav>
        <main>
            <article>
                <h1>{post.data.title}</h1>
                <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <hr>
                <Content />
            </article>
        </main>
    </div>
</BaseLayout>
