---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog - Kevan Ahlquist"
  description="Writing by Kevan Ahlquist."
  ogTitle="Blog - Kevan Ahlquist"
  ogUrl="https://www.kevanahlquist.com/blog/"
>
    <main>
        <h1>Blog</h1>
        {posts.length === 0 && <p>No posts yet.</p>}
        <ul>
            {posts.map(post => (
                <li>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    <span> — {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                </li>
            ))}
        </ul>
    </main>
</BaseLayout>
