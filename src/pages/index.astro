---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import profileImg from '../images/profile.jpg';
---

<BaseLayout
  title="Kevan Ahlquist"
  description="I'm a Principal Software Engineer working with Amazon in the Minneapolis area. My passion is helping teams solve hard problems. I graduated with a degree in computer science from the University of Minnesota."
  keywords="Kevan,Ahlquist,fullstack,full-stack,Software,Engineering,Minneapolis,Minnesota"
  ogTitle="Kevan Ahlquist"
  ogDescription="Principal Software Engineer at Amazon in Minneapolis."
  ogUrl="https://www.kevanahlquist.com/"
>
    <main>
        <h1>Kevan Ahlquist</h1>

        <Image src={profileImg} alt="Kevan Ahlquist" class="avatar" width={350} height={350} quality="max" loading="eager" />
        <nav>
            <ul class="nav">
                <li><a href="mailto:kevan@kevanahlquist.com">Email</a></li>
                <li><a href="https://www.linkedin.com/in/kevan-ahlquist-56297091/" target="_blank" rel="noopener">LinkedIn</a></li>
                <li><a href="https://twitter.com/KevanAhlquist" target="_blank" rel="noopener">@KevanAhlquist</a></li>
                <li><a href="/blog">Blog</a></li>
            </ul>
        </nav>

        <hr>
        <section>
            <h2>About Me</h2>
            <p>I'm a Principal Software Engineer working with Amazon in the Minneapolis area. My passion is helping teams solve hard problems.</p>
            <p>I graduated with a degree in computer science from the University of Minnesota.</p>
        </section>

        <hr>

        <section>
            <h2>My work</h2>
            <p>I'm currently building and operating middle-mile transportation systems that power <a href="https://relay.amazon.com/" target="_blank" rel="noopener">Amazon Relay</a>.</p>
            <p>I previously contributed to Bluestem Brand's next-generation commerce platform development including self-service feature design and implementation as well as automated testing and deployment.</p>
            <p>Check out my personal projects (like <a href="https://github.com/kevana/ui-for-docker" target="_blank" rel="noopener">UI for Docker</a>) on <a href="https://www.github.com/kevana" rel="noopener">GitHub</a>.</p>
        </section>

        <hr>

        <section>
            <h2>Who I've worked with</h2>
            <div class="center">
            <ul>
                <li><a href="https://www.amazon.com/" target="_blank" rel="noopener">Amazon</a></li>
                <li><a href="https://en.wikipedia.org/wiki/Fingerhut" target="_blank" rel="noopener">Bluestem Brands</a></li>
                <li><a href="https://www.oati.com" target="_blank" rel="noopener">Open Access Technology International</a></li>
                <li><a href="https://www.sa-solutions.com/" target="_blank" rel="noopener">Superior Access Solutions</a></li>
                <li>Two summers touring with the <a href="https://bluecoats.com/" target="_blank" rel="noopener">Bluecoats.</a></li>
                <li>One international tour with the <a href="https://bluedevils.org/" target="_blank" rel="noopener">Blue Devils.</a></li>
            </ul>
            </div>
        </section>
    </main>
</BaseLayout>
